# THIS FILE IS AUTOMATICALLY GENERATED BY CARGO
#
# When uploading crates to the registry Cargo will automatically
# "normalize" Cargo.toml files for maximal compatibility
# with all versions of Cargo and also rewrite `path` dependencies
# to registry (e.g., crates.io) dependencies.
#
# If you are reading this file be aware that the original Cargo.toml
# will likely look very different (and much more reasonable).
# See Cargo.toml.orig for the original contents.

[package]
edition = "2024"
rust-version = "1.91.0"
name = "lancedb"
version = "0.37.1"
build = false
autolib = false
autobins = false
autoexamples = false
autotests = false
autobenches = false
description = "LanceDB: A serverless, low-latency vector database for AI applications"
readme = "README.md"
keywords = [
    "lancedb",
    "lance",
    "database",
    "vector",
    "search",
]
categories = ["database-implementations"]
license = "Apache-2.0"
repository = "https://github.com/lancedb/lancedb"
resolver = "2"

[package.metadata.docs.rs]
all-features = true

[features]
aws = [
    "lance/aws",
    "lance-io/aws",
    "lance-namespace-impls/dir-aws",
    "object_store/aws",
]
azure = [
    "lance/azure",
    "lance-io/azure",
    "lance-namespace-impls/dir-azure",
    "lance-namespace-impls/credential-vendor-azure",
]
bedrock = ["dep:aws-sdk-bedrockruntime"]
cos = [
    "lance/tencent",
    "lance-io/tencent",
]
default = []
dynamodb = [
    "lance/dynamodb",
    "aws",
]
fp16kernels = ["lance-linalg/fp16kernels"]
gcs = [
    "lance/gcp",
    "lance-io/gcp",
    "lance-namespace-impls/dir-gcp",
]
goosefs = [
    "lance/goosefs",
    "lance-io/goosefs",
    "lance-namespace-impls/dir-goosefs",
]
huggingface = [
    "lance/huggingface",
    "lance-io/huggingface",
    "lance-namespace-impls/dir-huggingface",
]
metrics = [
    "dep:metrics",
    "lance/metrics",
    "lance-io/metrics",
]
metrics-otel = [
    "metrics",
    "dep:metrics-util",
]
openai = [
    "dep:async-openai",
    "dep:reqwest",
]
oss = [
    "lance/oss",
    "lance-io/oss",
    "lance-namespace-impls/dir-oss",
]
polars = [
    "dep:polars-arrow",
    "dep:polars",
]
remote = [
    "dep:reqwest",
    "dep:http",
    "dep:urlencoding",
    "lance-namespace-impls/rest",
    "lance-namespace-impls/rest-adapter",
]
s3-test = []
sentence-transformers = [
    "dep:hf-hub",
    "dep:candle-core",
    "dep:candle-transformers",
    "dep:candle-nn",
    "dep:tokenizers",
]

[lib]
name = "lancedb"
path = "src/lib.rs"

[[example]]
name = "bedrock"
path = "examples/bedrock.rs"
required-features = ["bedrock"]

[[example]]
name = "bench_streaming_dataloader"
path = "examples/bench_streaming_dataloader.rs"

[[example]]
name = "full_text_search"
path = "examples/full_text_search.rs"

[[example]]
name = "hybrid_search"
path = "examples/hybrid_search.rs"
required-features = ["sentence-transformers"]

[[example]]
name = "ivf_pq"
path = "examples/ivf_pq.rs"

[[example]]
name = "openai"
path = "examples/openai.rs"
required-features = ["openai"]

[[example]]
name = "polars"
path = "examples/polars.rs"
required-features = ["polars"]

[[example]]
name = "sentence_transformers"
path = "examples/sentence_transformers.rs"
required-features = ["sentence-transformers"]

[[example]]
name = "simple"
path = "examples/simple.rs"

[[test]]
name = "blob_integration"
path = "tests/blob_integration.rs"

[[test]]
name = "embedding_registry_test"
path = "tests/embedding_registry_test.rs"

[[test]]
name = "embeddings_parallel_test"
path = "tests/embeddings_parallel_test.rs"

[[test]]
name = "object_store_test"
path = "tests/object_store_test.rs"

